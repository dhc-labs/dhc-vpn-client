 METHOD(kernel_net_t, add_ip, status_t,
 	private_kernel_iph_net_t *this, host_t *virtual_ip, int prefix,
 	char *iface_name)
 {
-	return NOT_SUPPORTED;
+	NET_LUID *luid = lib->get(lib, "kernel-wintun-luid");
+	MIB_UNICASTIPADDRESS_ROW row;
+	DWORD r;
+
+	/* No Wintun adapter exposed by kernel-wintun plugin -> behave as
+	 * the original stub (charon will skip VIP install). */
+	if (!luid)
+	{
+		return NOT_SUPPORTED;
+	}
+
+	InitializeUnicastIpAddressEntry(&row);
+	row.InterfaceLuid = *luid;
+	host2sockaddr_inet(virtual_ip, &row.Address);
+	row.OnLinkPrefixLength = prefix;
+	row.DadState = IpDadStatePreferred;
+
+	r = CreateUnicastIpAddressEntry(&row);
+	if (r != NO_ERROR)
+	{
+		DBG1(DBG_KNL, "CreateUnicastIpAddressEntry(%H/%d) failed: %lu",
+			 virtual_ip, prefix, r);
+		return FAILED;
+	}
+	DBG1(DBG_KNL, "installed VIP %H/%d on kernel-wintun adapter",
+		 virtual_ip, prefix);
+	return SUCCESS;
 }

