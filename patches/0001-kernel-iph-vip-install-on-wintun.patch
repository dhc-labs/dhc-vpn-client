+/**
+ * Fill a SOCKADDR_INET from a strongSwan host_t.
+ */
+static void host2sockaddr_inet(host_t *h, SOCKADDR_INET *sa)
+{
+	chunk_t addr = h->get_address(h);
+
+	memset(sa, 0, sizeof(*sa));
+	if (h->get_family(h) == AF_INET && addr.len == 4)
+	{
+		sa->Ipv4.sin_family = AF_INET;
+		memcpy(&sa->Ipv4.sin_addr, addr.ptr, 4);
+	}
+	else if (h->get_family(h) == AF_INET6 && addr.len == 16)
+	{
+		sa->Ipv6.sin6_family = AF_INET6;
+		memcpy(&sa->Ipv6.sin6_addr, addr.ptr, 16);
+	}
+}
